# Copy this file to ".env" (same folder) and fill in your own key.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Email meeting reminders (optional) ---
# If left unset, the app runs fine without sending real reminders — it just
# logs a clear warning instead of crashing or pretending to send one.
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_email
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email

# Set to "console" to test the reminder workflow locally without any real
# SMTP credentials — reminders print to the backend terminal instead of
# being sent. Leave unset/blank for normal (real email) behavior.
NOTIFICATION_MODE=

# Optional short-delay test mode. Leave both unset for normal 10-minute reminders.
# REMINDER_TEST_SECONDS=30
# REMINDER_TEST_MINUTES=1
